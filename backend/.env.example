PROJECT_NAME="AI-Integrated University Student Support ERP"
API_V1_STR="/api/v1"
SECRET_KEY="university-erp-super-secret-jwt-key-for-dev-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for zero-setup local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./data/university_erp.db"
# PostgreSQL Example: DATABASE_URL="postgresql://postgres:password@localhost:5432/university_erp"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# RAG & AI Settings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
FAISS_INDEX_PATH="./data/faiss_index"
DOCUMENTS_STORAGE_PATH="./data/documents"
GEMINI_API_KEY=""
