# ============================================================
# UNIVERSITY ERP + PUBLIC DATA INGESTION + GENERATIVE AI/RAG
# Production & Development Environment Configuration Template
# ============================================================

# Institutional Branding & Environment
PROJECT_NAME="Dayananda Sagar University AI-Integrated ERP"
VERSION="1.0.0"
ENVIRONMENT="development"

# Server Host & API Prefixes
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
API_V1_STR="/api/v1"

# Database Configuration (Relational ERP DB)
DATABASE_URL="sqlite:///./data/university_erp.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/university_erp"

# Authentication & Security
JWT_SECRET="university-erp-super-secret-jwt-key-for-dev-change-in-prod"
SECRET_KEY="university-erp-super-secret-jwt-key-for-dev-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dedicated Email Service Configuration (SMTP / Notifications)
EMAIL_PROVIDER="smtp"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USERNAME="admissions@dsuonline.com"
EMAIL_PASSWORD="your-secure-app-password-here"
EMAIL_FROM="Dayananda Sagar University <admissions@dsuonline.com>"

# AI & LLM Engine Configuration
LLM_API_KEY=""
GEMINI_API_KEY=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Vector Database & Storage Paths
VECTOR_DATABASE_URL="./data/faiss_index"
FAISS_INDEX_PATH="./data/faiss_index"
DOCUMENTS_STORAGE_PATH="./data/documents"

# Public University Ingestion Crawler
CRAWLER_DEFAULT_ALLOWED_DOMAINS="ums.mydsi.org,dsu.edu.in"
CRAWLER_MAX_PAGES_PER_JOB=25
CRAWLER_REQUEST_DELAY_MS=500

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
